{% if include.id %}
  {% assign feature_row = page[include.id] %}
{% else %}
  {% assign feature_row = page.feature_row %}
{% endif %}

<div class="feature__wrapper{% if include.variant %} feature__wrapper--{{ include.variant }}{% endif %}">
  <div class="feature__grid">
    {% for f in feature_row %}
      <a href="{{ f.url | relative_url }}" class="feature__widget">
        <div class="archive__item">
          {% if f.image_path %}
            <div class="archive__item-teaser">
              <img src="{{ f.image_path | relative_url }}" alt="{% if f.alt %}{{ f.alt }}{% endif %}" width="1600" height="1000" loading="lazy" decoding="async">
            </div>
          {% endif %}

          <div class="archive__item-body">
            {% if f.title %}
              <h2 class="archive__item-title">{{ f.title }}</h2>
            {% endif %}

            {% if f.excerpt %}
              <div class="archive__item-excerpt">
                {{ f.excerpt | markdownify }}
              </div>
            {% endif %}
            <div class="archive__item-footer">
              {% if f.meta %}
                <span class="archive__item-tags">
                  {% assign item_tags = f.meta | split: " · " %}
                  {% for tag in item_tags %}<span class="archive__item-tag">{{ tag }}</span>{% endfor %}
                </span>
              {% endif %}
              <span class="archive__item-link">View project <span aria-hidden="true">↗</span></span>
            </div>
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>


